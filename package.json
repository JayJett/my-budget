{
  "name": "my-budget",
  "private": true,
  "description": "Budget visualiser. No build step: the browser loads the files in js/ directly.",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "test:browser": "node --test --test-concurrency=1 \"tests/browser/*.test.js\"",
    "test:sql": "node --test \"tests/sql/*.test.js\""
  }
}
